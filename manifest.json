{
  "manifest_version": 3,
  "name": "Localhost Dashboard",
  "version": "1.0.0",
  "description": "Shows the title + a live preview of whatever is running on your localhost ports.",
  "permissions": ["storage", "tabs", "nativeMessaging", "geolocation"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://v6.bvg.transport.rest/*",
    "https://api.brightsky.dev/*",
    "https://opendata.dwd.de/*",
    "https://luftdaten.umweltbundesamt.de/*",
    "https://air-quality-api.open-meteo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Localhost Dashboard"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "chrome_url_overrides": {
    "newtab": "dashboard.html"
  },
  "icons": {}
}
